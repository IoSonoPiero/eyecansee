<?xml version="1.0" encoding="utf-8"?>
<!-- The Microsoft Store package. tools/msix.ps1 fills in @VERSION@ and @FILETYPES@ (the same
     extensions as the installer's "Open with", read from tools/eyecansee.iss).
     The identity is the one Partner Center reserved for EyeCanSee: never change it. -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap rescap">
  <Identity Name="PierluigiMontinaro.EyeCanSee"
            Publisher="CN=F2E8FA38-D8A9-4E9C-9A63-42325AA480E6"
            Version="@VERSION@"
            ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>EyeCanSee</DisplayName>
    <PublisherDisplayName>Pierluigi Montinaro</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Resources>
    <Resource Language="en-us" />
    <Resource Language="it-it" />
  </Resources>
  <Applications>
    <Application Id="EyeCanSee" Executable="eyecansee.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="EyeCanSee" Description="Image viewer and manager"
                          BackgroundColor="transparent"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="eyecansee">
            <uap:SupportedFileTypes>
@FILETYPES@
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <!-- A desktop (Win32) program: phones over WPD, drives, the Recycle Bin, FFmpeg and mpv. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
